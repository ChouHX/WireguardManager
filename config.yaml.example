# ============================================================
#  WireGuard Manager 启动配置
#
#  这里只保留「必须在启动时决定」的参数：
#    监听端口、数据库路径、JWT 密钥、配置目录、初始管理员。
#
#  网络网段 / 起始端口 / 出口网卡 / 公网 IP / DNS / 客户端 AllowedIPs、
#  监控采集、在线判定、登录有效期、新设备是否默认启用预共享密钥——
#  这些都可以在管理界面「系统设置」里调整，并持久化在数据库中。
#
#  下表中的值仅作为「首次启动的初始默认值」：一旦在界面上改过，
#  就以数据库中的值为准，这里的改动不再生效。
#
#  环境变量优先级最高（WM_*），容器部署可用它注入密钥。
# ============================================================

server:
  port: 3000                 # 控制台与 API 共用端口（单容器）
  mode: "release"            # debug / release / test
  cors_origins:
    - "*"

database:
  # SQLite 数据库文件路径。相对路径基于进程工作目录：
  #   本地开发（仓库根目录运行）-> ./data/cloud_platform.db
  #   Docker（WORKDIR=/root）  -> /root/data/cloud_platform.db，对应挂载 ./data:/root/data
  path: "./data/cloud_platform.db"

jwt:
  secret: "change-me-to-a-long-random-string"   # 必填，至少 8 个字符
  expire_hours: 24                              # 之后可在系统设置中调整

network:
  config_dir: "/etc/wg_config"   # WireGuard 配置文件目录（容器内路径）

  # 以下为初始默认值，可在管理界面调整（改这里只在首次启动时生效）
  base_subnet: "10.100"          # 隧道网段前缀
  base_port: 51820               # 每账号 WireGuard 端口起始值
  out_interface: "eth0"          # 出口网卡（管理界面可自动探测并改选）
  server_ip: "1.2.3.4"           # 服务器公网 IP，下发到客户端配置
  dns: "1.1.1.1, 8.8.8.8"        # 下发给客户端的 DNS
  client_allowed_ips: ""         # 客户端 AllowedIPs，留空按设备所在网段推导

monitoring:
  interval_seconds: 10           # 指标采样间隔
  retention_hours: 168           # 监控记录保留时长（7 天）
  cleanup_interval_hours: 24     # 过期记录清理周期

liveness:
  enabled: true
  interval_seconds: 2            # 探测间隔（秒级感知）
  probe_timeout_ms: 1000         # 单次 ICMP 探测超时
  offline_threshold: 2           # 连续多少次无响应即判离线（约 4 秒）
  handshake_timeout_seconds: 180 # 握手时效，作为最后的弱信号
  traffic_stale_seconds: 40      # 流量保护窗口，需大于保活间隔（默认 25 秒）
  max_concurrency: 16            # 并发探测上限

# 首次启动时创建的管理员账号，仅在数据库中还没有管理员时生效
default:
  admin_email: "admin@platform.com"
  admin_password: "password"
  admin_name: "admin"
