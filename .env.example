# 部署变量（全部可选）
#
# 通常不需要这个文件：默认端口 3000、数据存到 ./data、JWT 密钥在首次启动时
# 自动生成并保存到 ./data/jwt.secret。只有需要覆盖默认值时才复制本文件：
#
#   cp .env.example .env
#
# 也可以直接修改 docker-compose.yml 里的默认值。

# 控制台与 API 端口
# WM_SERVER_PORT=3000

# 时区
# TZ=Asia/Shanghai

# 数据目录（宿主机路径，容器内挂载为 /root/data）
# DATA_DIR=./data

# 显式指定 JWT 密钥（留空则自动生成并持久化）
# WM_JWT_SECRET=

# 首次启动创建的管理员
# WM_DEFAULT_ADMIN_EMAIL=admin@platform.com
# WM_DEFAULT_ADMIN_PASSWORD=password