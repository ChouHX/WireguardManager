# ============ Docker Compose 变量 ============
# Timezone
TZ=Asia/Shanghai

# SQLite 数据目录（相对仓库根），映射到容器内 /root/data
DATA_DIR=./data

# ============ 后端 WM_* 覆盖变量（可选） ============
# 后端优先读取 config.yaml，以下环境变量优先级更高，便于容器化/密钥注入。
# 未设置的项保持 config.yaml 或内置默认值。

# 服务
# WM_SERVER_PORT=8080
# WM_SERVER_MODE=release
# WM_SERVER_CORS_ORIGINS=*

# 数据库（嵌入式 SQLite，无需外部数据库服务）
# WM_DB_PATH=./data/cloud_platform.db
# WM_DB_MAX_OPEN_CONNS=1
# WM_DB_BUSY_TIMEOUT_MS=5000
# WM_DB_WAL=true

# 鉴权
# WM_JWT_SECRET=change-me-to-a-long-random-string
# WM_JWT_EXPIRE_HOURS=24

# 网络（WireGuard / netns）
# WM_NETWORK_CONFIG_DIR=/etc/wg_config
# WM_NETWORK_BASE_SUBNET=10.200
# WM_NETWORK_BASE_PORT=51820
# WM_NETWORK_OUT_INTERFACE=eth0
# WM_NETWORK_SERVER_IP=1.2.3.4
# WM_NETWORK_DNS=1.1.1.1, 8.8.8.8

# 监控采集
# WM_MONITORING_INTERVAL_SECONDS=10
# WM_MONITORING_RETENTION_HOURS=168
# WM_MONITORING_CLEANUP_INTERVAL_HOURS=24

# 默认管理员（首次启动且库中无管理员时创建）
# WM_DEFAULT_ADMIN_EMAIL=admin@platform.com
# WM_DEFAULT_ADMIN_PASSWORD=password
# WM_DEFAULT_ADMIN_NAME=admin
