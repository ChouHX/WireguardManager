# ============================================================
#  WireGuard Manager 部署变量
#
#  只有 JWT 密钥是必填项，其余不填都会使用默认值。
#  网络网段 / 出口网卡 / 公网 IP / DNS / 监控 / 在线判定 / 登录有效期
#  等运行时可调项已移至管理界面「系统设置」，无需在此配置。
# ============================================================

# ---------- 必填 ----------
# JWT 签名密钥，至少 8 位；留空后端会拒绝启动。
# 生成方式：openssl rand -hex 32
WM_JWT_SECRET=

# ---------- 常用可选项 ----------
TZ=Asia/Shanghai
# 控制台与 API 共用端口
WM_SERVER_PORT=3000
# SQLite 数据目录（相对仓库根），容器内映射为 /root/data
DATA_DIR=./data

# ---------- 首次启动创建的管理员 ----------
WM_DEFAULT_ADMIN_EMAIL=admin@platform.com
WM_DEFAULT_ADMIN_PASSWORD=password
WM_DEFAULT_ADMIN_NAME=admin

# ============================================================
#  以下一般无需修改
# ============================================================

# 服务
# WM_SERVER_MODE=release
# WM_SERVER_CORS_ORIGINS=*

# 数据库
# WM_DB_PATH=./data/cloud_platform.db
# WM_DB_MAX_OPEN_CONNS=1
# WM_DB_BUSY_TIMEOUT_MS=5000
# WM_DB_WAL=true

# 运行目录
# WM_NETWORK_CONFIG_DIR=/etc/wg_config

# 运行时可调项的初始值：首次启动写入数据库后即以界面配置为准
# WM_NETWORK_BASE_SUBNET=10.100
# WM_NETWORK_BASE_PORT=51820
# WM_NETWORK_OUT_INTERFACE=eth0
# WM_NETWORK_SERVER_IP=1.2.3.4
# WM_NETWORK_DNS=1.1.1.1, 8.8.8.8
# WM_NETWORK_CLIENT_ALLOWED_IPS=
# WM_MONITORING_INTERVAL_SECONDS=10
# WM_MONITORING_RETENTION_HOURS=168
# WM_LIVENESS_ENABLED=true
# WM_LIVENESS_INTERVAL_SECONDS=2
# WM_LIVENESS_PROBE_TIMEOUT_MS=1000
# WM_LIVENESS_OFFLINE_THRESHOLD=2
# WM_LIVENESS_TRAFFIC_STALE_SECONDS=40
# WM_JWT_EXPIRE_HOURS=24
